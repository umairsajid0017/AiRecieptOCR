# Copy to .env and adjust for your environment:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Unified AI service
# Global switch and request timeout (ms)
# -----------------------------------------------------------------------------
AI_ENABLED=true
AI_TIMEOUT_MS=20000

# Provider credentials — set only the providers you use
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_API_KEY=

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Per-task routing: receipt/invoice image → structured JSON
# Provider options: ollama | groq | gemini | openrouter
AI_TASK_RECEIPT_VISION_ENABLED=true
AI_TASK_RECEIPT_VISION_PROVIDER=ollama
AI_TASK_RECEIPT_VISION_MODEL=ministral-3:8b-cloud
# Model examples by provider (vision-capable models required):
#   ollama:      ministral-3:8b-cloud, qwen3-vl:8b, llava, llama3.2-vision
#   groq:        llama-3.2-90b-vision-preview
#   openrouter:  qwen/qwen3-vl-8b-instruct, google/gemini-2.0-flash-001
#   gemini:      gemini-2.0-flash, gemini-1.5-flash

# Optional: image resize before sending to vision API (avoids request body too large)
# AI_VISION_MAX_PIXELS=2048
# AI_VISION_JPEG_QUALITY=88

# Deprecated (still read as fallback during migration):
# OLLAMA_VISION_MODEL=
# OLLAMA_VISION_MAX_PIXELS=2048
# OLLAMA_VISION_JPEG_QUALITY=88

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------
# async = return 202 + job_id, callback when done; sync = block and return JSON
API_MODE=async

# Callback URL for async receipt processing (POST with job_id + result when done)
CALLBACK_URL=

# Categories API for expense category picking (optional)
# CATEGORIES_API_URL=http://localhost:9000/api/receipts/categories?minify=true

FLASK_DEBUG=0

# Concurrency limit for OCR processing (number of requests that can run in parallel)
CONCURRENCY_LIMIT=10

